# Usage: run-node-test FILE.mjs
#
# Runs a JavaScript test with Node.js, with GUILESCRIPT set to the
# guilescript command of the source tree. Exits with 77 (skip) if Node.js is
# not available.

set -u

srcdir=$(cd "$(dirname "$0")/.." && pwd)
NODE=${NODE:-node}

if ! command -v "$NODE" >/dev/null 2>&1; then
  echo "SKIP: $NODE not found"
  exit 77
fi

GUILE_LOAD_PATH="$srcdir${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
GUILESCRIPT="$srcdir/guilescript"
export GUILE_LOAD_PATH GUILESCRIPT

exec "$NODE" "$1"
