;; GuileScript CLI

;;; Code:

(define-module (guilescript)
  #:use-module (ice-9 getopt-long)
  #:use-module (ice-9 match)
  #:use-module (ice-9 textual-ports)
  #:use-module (srfi srfi-1)
  #:use-module (language guilescript compile)
  #:use-module (language guilescript modules)
  #:use-module (language javascript errors)
  #:use-module (language javascript source-map))

(define (usage port)
  (display "Usage: guilescript [OPTION]... FILE...

Compile GuileScript files into JavaScript.

  -o, --output=FILE      write the JavaScript code of FILE to FILE
                         (default: stdout)
  -d, --output-dir=DIR   compile the files and all the GuileScript modules
                         they import into DIR (e.g. the module (app util)
                         into DIR/app/util.js)
  -L, --load-path=DIR    also search GuileScript modules in DIR
      --source-map       generate source maps (FILE.js.map next to the
                         compiled files, or inline when writing to stdout)
      --source-imports   import GuileScript modules by the path of their
                         .gs file (e.g. ./util.gs), for bundler plugins
  -h, --help             display this help and exit
" port))

(define option-spec
  '((output (single-char #\o) (value #t))
    (output-dir (single-char #\d) (value #t))
    (load-path (single-char #\L) (value #t))
    (source-map (value #f))
    (source-imports (value #f))
    (help (single-char #\h) (value #f))))

(define (fail fmt . args)
  (apply format (current-error-port) fmt args)
  (newline (current-error-port))
  (exit 1))

(define (call-with-compile-errors file thunk)
  (catch #t
    thunk
    (lambda (key . args)
      (match (cons key args)
        (('guilescript-error message location)
         (fail "~a: error: ~a" (or (format-location location) file) message))
        (('syntax-error who message source form subform)
         (fail "~a: error: ~a: ~s"
               (or (format-location source) file) message (or subform form)))
        (('read-error who message message-args . _)
         (fail "~a: error: ~a" file (apply format #f message message-args)))
        (_
         (fail "~a: error: ~a" file
               (call-with-output-string
                 (lambda (p) (print-exception p #f key args)))))))))

(define (source-content file)
  (call-with-input-file file get-string-all))

;; Write the JavaScript code JS to OUTPUT and, if there is one, its
;; SOURCE-MAP (JSON) to OUTPUT.map.
(define (write-js output js source-map)
  (call-with-output-file output
    (lambda (p)
      (display js p)
      (when source-map
        (format p "//# sourceMappingURL=~a.map~%" (basename output)))))
  (when source-map
    (call-with-output-file (string-append output ".map")
      (lambda (p) (display source-map p)))))

;; Write the JavaScript code JS, compiled from SOURCE, to OUTPUT, with a
;; source map if there are MAPPINGS.
(define (write-output output source js mappings)
  (write-js output js
            (and mappings
                 (source-map-json mappings
                                  #:file (basename output)
                                  #:source (relative-file-path (dirname output) source)
                                  #:content (source-content source)))))

;; Write JS to stdout, with an inline source map if there are MAPPINGS.
(define (display-output source js mappings)
  (display js)
  (when mappings
    (format #t "//# sourceMappingURL=data:application/json;charset=utf-8;base64,~a~%"
            (base64-encode (source-map-json mappings
                                            #:source source
                                            #:content (source-content source))))))

(define (mkdir-p dir)
  (unless (file-exists? dir)
    (mkdir-p (dirname dir))
    (mkdir dir)))

;; Compile FILES, and the GuileScript modules they import, into OUTPUT-DIR.
(define (compile-project files output-dir load-path source-map?)
  ;; The output file of the module PATH (e.g. "app/util"). Its directory is
  ;; created, since relative-file-path needs it.
  (define (output-file path)
    (let ((output (string-append output-dir "/" path ".js")))
      (mkdir-p (dirname output))
      output))
  (for-each
   (match-lambda
     ((path js source-map)
      (write-js (output-file path) js source-map)))
   (call-with-compile-errors (car files)
     (lambda ()
       (compile-modules files
                        #:load-path load-path
                        #:source-map? source-map?
                        ;; The map is next to the compiled file.
                        #:source-map-source
                        (lambda (file path)
                          (relative-file-path (dirname (output-file path)) file)))))))

(define (main args)
  (let* ((options (catch 'misc-error
                    (lambda () (getopt-long args option-spec))
                    (lambda (key who message message-args . _)
                      (fail "guilescript: ~a" (apply format #f message message-args)))))
         (output (option-ref options 'output #f))
         (output-dir (option-ref options 'output-dir #f))
         (source-map? (option-ref options 'source-map #f))
         (load-path (filter-map (match-lambda
                                  (('load-path . dir) dir)
                                  (_ #f))
                                options)))
    (when (option-ref options 'help #f)
      (usage (current-output-port))
      (exit 0))
    (match (option-ref options '() '())
      ((? pair? files)
       (=> next)
       (if output-dir
           (compile-project files output-dir load-path source-map?)
           (next)))
      ((file)
       (call-with-values
           (lambda ()
             (call-with-mappings source-map?
               (lambda ()
                 (call-with-compile-errors file
                   (lambda ()
                     (compile-file file #:load-path load-path
                                   #:source-imports? (option-ref options 'source-imports #f)))))))
         (lambda (js mappings)
           (if output
               (write-output output file js mappings)
               (display-output file js mappings)))))
      (_
       (usage (current-error-port))
       (exit 1)))))
